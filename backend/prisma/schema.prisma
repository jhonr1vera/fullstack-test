datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String     @id @default(uuid())
  nombre    String
  email     String     @unique
  password  String
  activo    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?
  inmuebles Inmueble[]

  @@map("user")
}

model TipoInmueble {
  id        String     @id @default(uuid())
  codigo    String     @unique
  nombre    String
  activo    Boolean    @default(true)
  inmuebles Inmueble[]

  @@map("tipoInmueble")
}

model Inmueble {
  id              String       @id @default(uuid())
  direccion       String
  precio          Decimal
  habitaciones    Int
  metrosCuadrados Int
  tipoInmueble    TipoInmueble @relation(fields: [tipoInmuebleId], references: [id])
  tipoInmuebleId  String
  vendedor        User         @relation(fields: [vendedorId], references: [id])
  vendedorId      String
  estado          String       @default("DISPONIBLE")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?

  @@map("inmueble")
}
